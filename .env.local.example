# MiniMax (or any Anthropic SDK 相容 endpoint) API key
MINIMAX_API_KEY=sk-cp-xxx

# 登入帳號 — JSON array，每個物件含 account / name / role / password
# role 只接受 "admin" 或 "member"
# 範例：兩個帳號 udo (管理員) 跟 esun (成員)
AUTH_USERS=[{"account":"udo","name":"管理員","role":"admin","password":"YOUR_PASSWORD_HERE"},{"account":"esun","name":"成員","role":"member","password":"YOUR_PASSWORD_HERE"}]

# 全域 LLM 並行上限（選填，預設 6）— persona agent 用 bundled JSON 一次回 5 題，
# call 數從 150 砍到 30，c=6 安全；逐題模式（fallback）建議降到 3
LLM_MAX_CONCURRENCY=6
